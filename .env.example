# Noble AI — ejemplo de configuración. Copiar como .env (no subir secretos)
NOBLE_ENV=development
NOBLE_API_HOST=127.0.0.1
NOBLE_API_PORT=8000
NOBLE_DATABASE_URL=sqlite:///./data/noble.sqlite
NOBLE_ASSETS_DIR=./data/assets
NOBLE_LANGUAGE=es-419
# El LLM debe estar disponible como servicio durante la sesión
NOBLE_LLM_PROVIDER=koboldcpp
NOBLE_LLM_BASE_URL=http://127.0.0.1:5001/v1
NOBLE_LLM_MODEL=local
NOBLE_LLM_TIMEOUT_SECONDS=180
# Las imágenes se generan por escena y se reutiliza caché
NOBLE_IMAGE_PROVIDER=comfyui
NOBLE_COMFYUI_BASE_URL=http://127.0.0.1:8188
NOBLE_IMAGE_AUTO_ON_SCENE_CHANGE=true
NOBLE_MAX_IMAGE_JOBS=1
# Voz desactivada hasta petición explícita
NOBLE_TTS_PROVIDER=chatterbox
NOBLE_TTS_ENABLED=false
NOBLE_TTS_AUTOREAD=false
# Perfil teórico; medir antes de activar combinaciones pesadas
NOBLE_GPU_PROFILE=recommended_16gb
NOBLE_GPU_RESERVED_MB=1800
# LAN opcional: solo después de definir autentificación y origen explícito
NOBLE_LAN_ENABLED=false
