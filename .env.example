# Desarrollo del backend Noble AI — NO es una configuración obligatoria para el usuario final.
# La app tendrá wizard/ajustes persistentes en la base de datos; el .env define puertos y rutas de desarrollo.
NOBLE_ENV=development
NOBLE_API_HOST=127.0.0.1
NOBLE_API_PORT=8000
NOBLE_DATABASE_URL=sqlite:///./data/noble.sqlite
NOBLE_ASSETS_DIR=./data/assets
NOBLE_MODELS_DIR=./data/models
NOBLE_LANGUAGE=es-419
# Sin modelos en el primer arranque; la app se abre y permite instalarlos.
NOBLE_SETUP_COMPLETED=false
NOBLE_MODEL_SEARCH_SOURCE=huggingface
NOBLE_LLM_PROVIDER=
NOBLE_LLM_BASE_URL=
NOBLE_LLM_MODEL=
NOBLE_LLM_TIMEOUT_SECONDS=180
# Imágenes progresivas solo si hay proveedor configurado
NOBLE_IMAGE_PROVIDER=
NOBLE_COMFYUI_BASE_URL=
NOBLE_IMAGE_AUTO_ON_SCENE_CHANGE=true
NOBLE_MAX_IMAGE_JOBS=1
# Voz desactivada; no se carga un modelo hasta petición expresa
NOBLE_TTS_PROVIDER=
NOBLE_TTS_ENABLED=false
NOBLE_TTS_AUTOREAD=false
# Perfil GPU AUTO recomendado antes de diagnóstico
NOBLE_GPU_PROFILE=auto
NOBLE_GPU_RESERVED_MB=1800
NOBLE_LAN_ENABLED=false
